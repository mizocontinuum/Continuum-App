{
    // Debug configurations for the Continuum app shell (assets/js/**).
    // The dev server is provided by a task in .vscode/tasks.json so that F5
    // starts it, then launches/attaches Chrome on the same origin (:3000).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug app (static, python3)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000/",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "serve: static (python3)"
        },
        {
            "name": "Debug app (vercel dev, full API)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000/login/",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "serve: vercel dev"
        },
        {
            // Server already running, e.g. `vercel dev` in an external terminal
            // or Chrome started with --remote-debugging-port=9222.
            "name": "Attach to Chrome (port 9222)",
            "type": "chrome",
            "request": "attach",
            "port": 9222,
            "url": "http://localhost:3000/*",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
