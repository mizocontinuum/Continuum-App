{
    // Dev servers used as `preLaunchTask` targets by .vscode/launch.json.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "serve: static (python3)",
            "detail": "Static-only preview on http://localhost:3000 — pages render, but /api/* is unavailable (auth pages will bounce to /login/).",
            "type": "shell",
            "command": "python3 -m http.server 3000 --bind 127.0.0.1",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "http.server",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Serving HTTP",
                    "endsPattern": "port 3000"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "group": "devservers"
            }
        },
        {
            "label": "serve: vercel dev",
            "detail": "Full stack on http://localhost:3000 (static site + /api/* functions). Requires Node.js 22.x and the Vercel CLI, then `npm install`.",
            "type": "shell",
            "command": "vercel dev --listen 3000",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vercel",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Vercel CLI|Loading",
                    "endsPattern": "Ready|available at|http://localhost:3000"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "group": "devservers"
            }
        }
    ]
}
