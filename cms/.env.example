# ---------------------------------------------------------------------------
# Continuum CMS — environment
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Payload signing secret. Use a long, random string (32+ chars).
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public URL where this CMS is served (used for admin links & absolute URLs).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database — Supabase Postgres.
#   Local / migrations : use the DIRECT connection (port 5432)
#   Vercel / serverless: use the CONNECTION POOLER (port 6543) and append
#                        ?pgbouncer=true&sslmode=require
# Find both URIs in Supabase: Project Settings -> Database -> Connection string.
DATABASE_URI=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Comma-separated browser origins allowed to call the CMS API (CORS/CSRF).
# Add every deployed origin of the static app, without a trailing slash.
FRONTEND_URLS=http://localhost:3000,https://ctm-app-v1.vercel.app

# Vercel Blob — REQUIRED in production so media uploads persist across
# serverless invocations. Leave unset for local dev (uploads go to /media).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
